# Copy to .env and fill in. Never commit .env.

# Required. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Max simultaneous LLM calls (free-tier friendly).
LLM_MAX_CONCURRENCY=2

# Models per role. Blank means "use the default in CONTRACT.md section 6".
# The judge must resolve to a different model than the generator.
GEN_MODEL=gemini-2.5-flash
GEN_MODEL_FALLBACK=gemini-2.5-flash-lite
CRITIC_MODEL=gemini-2.5-flash
CRITIC_MODEL_FALLBACK=gemini-2.5-flash-lite
JUDGE_MODEL=gemini-2.5-pro
JUDGE_MODEL_FALLBACK=gemini-2.5-flash-lite
